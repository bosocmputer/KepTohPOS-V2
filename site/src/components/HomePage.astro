---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Pain from './Pain.astro';
import OfflineDemo from './OfflineDemo.astro';
import Features from './Features.astro';
import TaxInvoice from './TaxInvoice.astro';
import HowToStart from './HowToStart.astro';
import Founding from './Founding.astro';
import Faq from './Faq.astro';
import FinalCta from './FinalCta.astro';
import Footer from './Footer.astro';
import Floating from './Floating.astro';
import type { Locale } from '../i18n';
const { locale } = Astro.props as { locale: Locale };
---
<Base locale={locale}>
  <Header locale={locale} />
  <main id="main">
    <Hero locale={locale} />
    <Pain locale={locale} />
    <OfflineDemo locale={locale} />
    <Features locale={locale} />
    <TaxInvoice locale={locale} />
    <HowToStart locale={locale} />
    <Founding locale={locale} />
    <Faq locale={locale} />
    <FinalCta locale={locale} />
  </main>
  <Footer locale={locale} />
  <Floating locale={locale} />
</Base>
