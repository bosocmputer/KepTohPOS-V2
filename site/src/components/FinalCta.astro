---
import Icon from './Icon.astro';
import { APP_URL } from '../config';
import { copy, type Locale } from '../i18n';
const t = copy[Astro.props.locale];
---
<section class="sec sec--dark final" id="final">
  <div class="wrap center" data-reveal>
    <h2 class="h2 h2--xl">{t.final.title}</h2>
    <p class="lead">{t.final.sub}</p>
    <a class="btn btn--primary btn--lg" href={APP_URL}>{t.cta.trial}</a>
  </div>
</section>
